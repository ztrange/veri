#!/bin/sh
# git and python3 on make unit's PATH only (#336; gh and curl are OFFLINE_BIN's already): a suite
# under tests/unit/ mocks these as shell functions, so reaching this file means it ran one as a
# process — the cost the fast tier exists to avoid. Refused, naming the command, so the suite fails
# loudly rather than slowly.
echo "make unit: $(basename "$0") called for real; a unit suite mocks it as a shell function" >&2
exit 1
