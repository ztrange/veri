#!/bin/sh
# git and python3 on make unit's PATH only: any call is refused, naming the command, and written
# to $UNIT_GUARD_LOG when it is set — save python3 on a module file under skills/tdd/scripts/veri/,
# which runs on the real interpreter.
here="$(dirname "$0")"
cmd="$(basename "$0")"
veri="$(cd "$here/../../veri" 2>/dev/null && pwd -P)"
if [ "$cmd" = python3 ] && [ -n "$veri" ] && [ -f "$1" ]; then
  module_dir="$(cd "$(dirname -- "$1")" && pwd -P)"
  case "$module_dir/" in
    "$veri"/*)
      path= rest="$PATH:"
      while [ -n "$rest" ]; do
        entry="${rest%%:*}" rest="${rest#*:}"
        [ "$entry" = "$here" ] || path="${path:+$path:}$entry"
      done
      real="$(PATH="$path" command -v python3)"
      exec "$real" "$@"
      ;;
  esac
fi
printf '%s\n' "$cmd $* (cwd $PWD)" >> "${UNIT_GUARD_LOG:-/dev/null}"
echo "make unit: $cmd called for real; a unit suite mocks it as a shell function" >&2
exit 1
