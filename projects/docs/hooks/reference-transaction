#!/usr/bin/env bash
# veri-docs-lag-notice — say so when a version tag arrives that the generated
# walkthrough does not list yet.
#
# WHY A GIT HOOK AND NOT A STEP IN THE MERGE SKILL: docs/walkthrough.html builds its
# capability index from `git tag`, so a tag is the one input that can change without
# a commit — and nothing rebuilds when it does. That is not a merge-time fact, it is
# a "someone moved a ref" fact, and it is just as true when a tag is cut by hand, by
# another agent, or in another worktree. `.git/hooks` is shared by every worktree of
# a repo, so installing this once covers all of them.
#
# IT ONLY NOTICES. It does not run `make docs` and it does not commit: which pull
# request should carry the rebuild is a judgement, and `make docs-check` already
# fails loudly and names the missing tag if nobody makes it. Deliberately no rebuild
# here also keeps the hook instant, which matters because git calls it on every ref
# transaction — every commit, every fetch.
#
# It tests the EFFECT, not the cause: "is this tag absent from the built page?" So a
# tag arriving by `git fetch` is silent when the page already lists it, and a tag cut
# by hand is caught. Guessing at the cause would get both backwards.
#
# Install: make install-hooks

# Only the committed state. In "prepared" a non-zero exit ABORTS the transaction, so
# this hook must never run its body there — a notice is not worth a failed `git tag`.
[ "$1" = committed ] || exit 0

page="docs/walkthrough.html"
[ -f "$page" ] || exit 0          # a bare repo, or a clone with no worktree yet

lagging=""
while read -r old _new ref; do
  case "$ref" in refs/tags/v*) ;; *) continue ;; esac
  # Creations only. A 40- or 64-zero old value means the ref did not exist; anything
  # else is an update or a delete, neither of which introduces a version.
  case "$old" in *[!0]*) continue ;; esac
  v="${ref#refs/tags/}"
  # The '<' matters: without it "vtag">v0.1 would match the row for v0.10.
  grep -qF "\"vtag\">$v<" "$page" && continue
  lagging="$lagging $v"
done

[ -n "$lagging" ] || exit 0

printf '\n  veri:%s created — %s does not list it yet.\n' "$lagging" "$page" >&2
printf '        Run `make docs` and commit the result; `make docs-check` fails until you do.\n\n' >&2
exit 0
